# ASON Space - generate-interior Edge Function 환경 변수 예시 파일.
#
# 실제 값은 이 파일(.env.example)에 절대 작성하지 않는다.
# 로컬 개발 시에는 이 파일을 복사해 같은 위치에 `.env`로 만들고
# 그 파일에만 실제 값을 채운다. `.env`는 git에 커밋하지 않는다.
#
# 배포 환경(Supabase 프로젝트)에는 이 파일 대신
# `supabase secrets set` 명령으로 값을 등록한다. 자세한 내용은
# 같은 폴더의 README.md를 참고한다.

# Fal.ai API Key.
# 이번 단계에서는 실제 값을 넣지 않는다(Mock 응답만 반환하므로 필요 없음).
FAL_API_KEY=

# 사용할 AI Provider. 현재는 fal만 실제로 의미 있게 사용될 예정이며,
# 나머지 값(openai/stability/replicate/mock)은 향후 확장을 위해
# 예약되어 있다.
AI_PROVIDER=fal
